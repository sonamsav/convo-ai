# =============================================================================
# ConvoAI Frontend Client Environment Variables (Vercel / Production)
# =============================================================================

# Production Backend API Base URL (Deployed Render Web Service)
# Example: https://convoai-api.onrender.com/api
VITE_API_BASE_URL=https://your-convoai-backend.onrender.com/api

# Production Socket.IO Server URL (Deployed Render Web Service)
# Usually the same origin as the backend service (without /api path)
# Example: https://convoai-api.onrender.com
VITE_SOCKET_URL=https://your-convoai-backend.onrender.com
