# =============================================================================
# ConvoAI Backend Server Environment Variables (Render / Production)
# =============================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/convoai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/convoai?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random 32+ character strings)
JWT_SECRET=your_production_jwt_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI Intelligence Engine (Server-Side Only)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# CORS Allowed Frontend Origin (Your Vercel deployment URL)
# Example: https://convoai.vercel.app or comma-separated origins
FRONTEND_URL=https://your-convoai-app.vercel.app

# API Rate Limiting (Default: 100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
