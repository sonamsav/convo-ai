# =============================================================================
# ConvoAI Enterprise Platform – Environment Configuration Template
# =============================================================================
# IMPORTANT: Copy this file to '.env' and populate with your environment secrets.
# NEVER commit your production '.env' file or API keys to version control.

# --- SERVER ENVIRONMENT ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- DATABASE CONFIGURATION ---
# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/convoai

# --- AUTHENTICATION & SECURITY ---
# Cryptographically random strings (at least 32 characters) for JWT signing
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- OPENAI INTELLIGENCE ENGINE (Server-Side Only) ---
# Your OpenAI API Secret Key (e.g. sk-proj-...)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- FRONTEND CLIENT VARIABLES (Vite prefixes with VITE_) ---
# When deployed, point to your backend API gateway and WebSocket server
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=http://localhost:5000
